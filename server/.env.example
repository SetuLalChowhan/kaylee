PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Auth Secrets
ACCESS_TOKEN_SECRET="your_access_token_secret_here"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_here"
RESET_TOKEN_SECRET="your_reset_token_secret_here"
PREVIEW_TOKEN_SECRET="your_preview_token_secret_here"

# Allowed Origins (comma-separated for CORS)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,https://getstakd.co"

# Admin Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="StrongPassword123!"

# Stripe Credentials
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="you@example.com"
SMTP_PASS="app_password"
EMAIL_FROM_HELLO="hello@getstakd.co"
EMAIL_FROM_SUPPORT="support@getstakd.co"
CLIENT_URL="https://getstakd.co"
