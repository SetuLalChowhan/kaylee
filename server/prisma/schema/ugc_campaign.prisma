model UgcCampaign {
  id            String               @id @default(uuid())
  userId        String
  name          String
  brandName     String
  deadline      String
  amount        String
  status        String               @default("Draft")
  releaseFiles  Boolean              @default(false)
  notes         String?
  slug          String               @unique
  shareToken    String?              @unique
  shareEnabled  Boolean              @default(true)
  shareExpiresAt DateTime?
  paymentStatus String               @default("Pending")
  rating        Int?
  ratingNote    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tasks         UgcCampaignTask[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliverables  UgcDeliverable[]
  documents     UgcDocument[]
  feedback      UgcFeedbackMessage[]
  media         UgcMedia[]
  notesComments UgcNote[]
  brandSessions UgcBrandSession[]
  otps          UgcOtp[]
  auditRecords  UgcApprovalAudit[]

  @@map("ugc_campaigns")
}

model UgcBrandSession {
  id         String      @id @default(uuid())
  campaignId String
  email      String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_brand_sessions")
}

model UgcOtp {
  id         String      @id @default(uuid())
  campaignId String
  email      String
  hash       String
  expiresAt  DateTime
  used       Boolean     @default(false)
  createdAt  DateTime    @default(now())
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_otps")
}

model UgcApprovalAudit {
  id         String      @id @default(uuid())
  campaignId String
  mediaId    String?
  action     String
  email      String?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  createdAt  DateTime    @default(now())
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_approval_audit")
}

model UgcRateLimit {
  id         String   @id @default(uuid())
  key        String   @unique
  points     Int      @default(0)
  expireAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ugc_rate_limits")
}

model UgcDeliverable {
  id         String      @id @default(uuid())
  campaignId String
  text       String
  progress   String[]    @default([])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_deliverables")
}

model UgcCampaignTask {
  id            String      @id @default(uuid())
  campaignId    String
  name          String
  date          String
  completed     Boolean     @default(false)
  plannerTaskId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  campaign      UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_campaign_tasks")
}

model UgcMedia {
  id           String               @id @default(uuid())
  campaignId   String
  name         String
  originalName String?
  type         String
  url          String
  description  String?
  assetType    String?
  status       String               @default("pending")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  feedback     UgcFeedbackMessage[]
  campaign     UgcCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_media")
}

model UgcDocument {
  id           String      @id @default(uuid())
  campaignId   String
  name         String
  originalName String?
  url          String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  campaign     UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_documents")
}

model UgcNote {
  id         String      @id @default(uuid())
  campaignId String
  text       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ugc_notes")
}

model UgcFeedbackMessage {
  id         String      @id @default(uuid())
  campaignId String
  text       String
  from       String
  mediaId    String?
  fileUrl    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   UgcCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  media      UgcMedia?   @relation(fields: [mediaId], references: [id])

  @@map("ugc_feedback_messages")
}
